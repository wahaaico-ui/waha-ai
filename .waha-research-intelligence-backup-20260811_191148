export interface IntelligenceRankedValue {
  value: string;
  count: number;
  percentage?: number;
}

export interface CitationStrength {
  q1Percentage: number;
  averageCitations: number;
  totalCitations: number;
}

export interface TopicMaturity {
  maturityLevel: string;
  trendScore: number;
  growthRate?: number;
}

export interface IntelligenceTimelinePoint {
  year: number;
  count: number;
  averageCitations?: number;
}

export interface ResearchActivity {
  period: string;
